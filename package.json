{
  "name": "obsidian-citation-plugin",
  "version": "0.5.1",
  "description": "Automatically search and insert citations from a Zotero library",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "lint": "eslint .",
    "test": "jest",
    "doc": "typedoc src/types.ts",
    "svelte:check": "svelte-check --tsconfig tsconfig.json"
  },
  "standard-version": {
    "bumpFiles": [
      "manifest.json"
    ]
  },
  "keywords": [],
  "author": "Sebastiaan Benjamins",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "esbuild": "^0.28.2",
    "esbuild-svelte": "^0.9.5",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.4.2",
    "obsidian": "^1.13.1",
    "prettier": "^3.9.6",
    "svelte": "^5.56.10",
    "svelte-check": "^4.7.6",
    "svelte-preprocess": "^6.0.5",
    "ts-jest": "^29.4.12",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.20",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.68.0",
    "unplugin-lightningcss": "^0.4.5"
  },
  "dependencies": {
    "@citation-js/core": "^0.6.9",
    "@citation-js/plugin-bibtex": "^0.6.9",
    "@citation-js/plugin-csl": "^0.6.9",
    "@citation-js/plugin-doi": "^0.6.9",
    "@citation-js/plugin-isbn": "^0.4.0",
    "@citation-js/plugin-orcid": "^0.3.1",
    "@citation-js/plugin-pubmed": "^0.3.0",
    "@lucide/svelte": "^1.35.0",
    "citeproc": "^2.4.63",
    "defuddle": "^0.19.3",
    "handlebars": "^4.7.9",
    "temporal-polyfill": "^1.0.4"
  },
  "lint-staged": {
    "*.ts": "eslint --fix",
    "*.json": "prettier --write"
  },
  "jest": {
    "moduleNameMapper": {
      "node-fetch": "<rootDir>/jest-fetch-mock.js",
      "sync-fetch": "<rootDir>/jest-fetch-mock.js",
      "^svelte/reactivity$": "<rootDir>/jest-svelte-reactivity.js",
      "^svelte(/.*)$": "<rootDir>/jest-svelte-reactivity.js"
    },
    "moduleFileExtensions": [
      "js",
      "ts",
      "d.ts"
    ],
    "transform": {
      "^.+\\.ts$": "ts-jest",
      "^.+\\.(csl|xml)$": "<rootDir>/jest-raw-transformer.js"
    }
  }
}
